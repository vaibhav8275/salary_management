{
  "openapi": "3.0.1",
  "info": {
    "title": "Salary Management API",
    "version": "v1",
    "description": "REST API for the Salary Management system.\nHandles the employee directory, salary records, bulk imports and reporting.\n\n## Authentication\n\nEvery endpoint needs the token issued by `POST /api/v1/auth/login`\n(LLD §9.4). Sign in there, then use the **Authorize** button at the top\nof this page to paste the token value; the docs and every request will\ncarry it as `Authorization: Bearer <token>`.\n\nThe token is returned in the `Authorization` *response* header of the\nsign-in call. Take everything after `Bearer ` when pasting it into\n**Authorize** — the field takes the token itself, not the header.\n"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "The JWT returned in the `Authorization` response header of `POST /api/v1/auth/login`. Paste the token without the `Bearer ` prefix. Tokens are not revocable and expire on their own (LLD §9.4)."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "hr@example.com"
              },
              "password": {
                "type": "string",
                "format": "password"
              }
            },
            "required": [
              "email",
              "password"
            ]
          }
        },
        "required": [
          "user"
        ]
      },
      "SignedInUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "hr@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "example": "resource not found"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "required": [
          "errors"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "example": 25
          },
          "total_count": {
            "type": "integer",
            "example": 100
          },
          "total_pages": {
            "type": "integer",
            "example": 4
          }
        },
        "required": [
          "current_page",
          "per_page",
          "total_count",
          "total_pages"
        ]
      },
      "Currency": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "example": "USD"
          },
          "name": {
            "type": "string",
            "example": "US Dollar"
          },
          "symbol": {
            "type": "string",
            "example": "$"
          }
        },
        "required": [
          "code",
          "name",
          "symbol"
        ]
      },
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "first_name": {
            "type": "string",
            "example": "Ada"
          },
          "last_name": {
            "type": "string",
            "example": "Lovelace"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "department": {
            "type": "string",
            "example": "Engineering"
          },
          "job_title": {
            "type": "string",
            "example": "Senior Software Engineer"
          },
          "country": {
            "type": "string",
            "example": "United Kingdom"
          },
          "hire_date": {
            "type": "string",
            "format": "date",
            "example": "2019-03-01"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "department",
          "job_title",
          "country",
          "hire_date"
        ]
      },
      "EmployeeDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Employee"
          },
          {
            "type": "object",
            "properties": {
              "currency": {
                "$ref": "#/components/schemas/Currency"
              }
            },
            "required": [
              "currency"
            ]
          }
        ]
      },
      "SalaryRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "base_salary": {
            "type": "string",
            "format": "decimal",
            "example": "50000.0"
          },
          "bonus": {
            "type": "string",
            "format": "decimal",
            "example": "1000.0"
          },
          "allowance": {
            "type": "string",
            "format": "decimal",
            "example": "500.0"
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "example": "2026-01-01"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        },
        "required": [
          "id",
          "base_salary",
          "bonus",
          "allowance",
          "effective_date",
          "currency"
        ]
      },
      "SalaryAudit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "whodunnit": {
            "type": "string",
            "example": "HR Manager"
          },
          "event": {
            "type": "string",
            "example": "create"
          },
          "source": {
            "type": "string",
            "example": "manual"
          },
          "salary_import_id": {
            "type": "integer",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "changed_by": {
            "type": "string",
            "example": "HR Manager"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "salary_record_id": {
            "type": "integer"
          },
          "changes": {
            "type": "object"
          },
          "changeset": {
            "type": "object"
          }
        }
      },
      "SalaryImport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "filename": {
            "type": "string",
            "example": "salaries-q1.csv"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "completed_with_errors",
              "failed"
            ]
          },
          "total_records": {
            "type": "integer",
            "example": 200
          },
          "processed_records": {
            "type": "integer",
            "example": 198
          },
          "failed_records": {
            "type": "integer",
            "example": 2
          },
          "created_by": {
            "type": "string",
            "example": "hr.manager1@example.com",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "filename",
          "status",
          "total_records",
          "processed_records",
          "failed_records"
        ]
      },
      "SalaryImportError": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "row_number": {
            "type": "integer",
            "example": 4
          },
          "employee_id": {
            "type": "integer",
            "example": 42,
            "nullable": true
          },
          "error_message": {
            "type": "string",
            "example": "Invalid base_salary 'abc'"
          },
          "raw_data": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "employee_id": "7",
              "base_salary": "abc"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "row_number",
          "error_message",
          "raw_data"
        ]
      },
      "SalaryImportErrorSummaryRow": {
        "type": "object",
        "properties": {
          "error_message": {
            "type": "string",
            "example": "Unknown employee 999999"
          },
          "count": {
            "type": "integer",
            "example": 12
          }
        },
        "required": [
          "error_message",
          "count"
        ]
      },
      "ReportRow": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "format": "decimal",
            "example": "60000.0"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "department": {
            "type": "string",
            "example": "Engineering"
          },
          "country": {
            "type": "string",
            "example": "United States"
          }
        }
      },
      "DistributionRow": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "example": "50000-75000"
          },
          "count": {
            "type": "integer",
            "example": 42
          },
          "currency": {
            "type": "string",
            "example": "USD"
          }
        },
        "required": [
          "range",
          "count",
          "currency"
        ]
      },
      "TrendRow": {
        "type": "object",
        "properties": {
          "effective_date": {
            "type": "string",
            "format": "date",
            "example": "2026-01-01"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "amount": {
            "type": "string",
            "format": "decimal",
            "example": "55000.0"
          }
        },
        "required": [
          "effective_date",
          "currency",
          "amount"
        ]
      },
      "EmployeeCountRow": {
        "type": "object",
        "properties": {
          "department": {
            "type": "string",
            "example": "Engineering"
          },
          "country": {
            "type": "string",
            "example": "United States"
          },
          "job_title": {
            "type": "string",
            "example": "Software Engineer"
          },
          "count": {
            "type": "integer",
            "example": 15
          }
        },
        "required": [
          "count"
        ]
      }
    }
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Sign in",
        "tags": [
          "Authentication"
        ],
        "operationId": "login",
        "security": [],
        "description": "Exchanges an email address and password for a JWT (LLD §9.4,\nREQUIREMENTS AU-2, AU-3).\n\nOn success the token is returned in the `Authorization` response header as\n`Bearer <jwt>`; the body only says which account signed in. Use the **Authorize**\nbutton above and paste the token, without the `Bearer ` prefix, to call every\nother endpoint in this API.\n\nThere is no sign-up, sign-out, or password-reset endpoint: the account is\ncreated by an operator with `bin/rails auth:create_hr_user`.\n\nInvalid credentials return 401 with the same body whether or not the email\nhas an account, so the response cannot be used to discover one (AU-2).\n",
        "parameters": [],
        "responses": {
          "200": {
            "description": "credentials accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SignedInUser"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/employees": {
      "get": {
        "summary": "List employees",
        "tags": [
          "Employees"
        ],
        "operationId": "listEmployees",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Filter by name (first, last, full), email, job title or id (FR-1.3)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by exact department name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Filter by exact country name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_title",
            "in": "query",
            "required": false,
            "description": "Filter by exact job title",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default: 1)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Page size (default: 25)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "employees returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Employee"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/employees/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Employee id",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Retrieve an employee",
        "tags": [
          "Employees"
        ],
        "operationId": "getEmployee",
        "responses": {
          "200": {
            "description": "employee found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/EmployeeDetail"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "employee not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/average-salary-by-department": {
      "get": {
        "summary": "Average salary by department",
        "tags": [
          "Reports"
        ],
        "operationId": "averageSalaryByDepartment",
        "description": "Average base salary per department, split by currency (BR-8, FR-7.1).\nA department that spans two countries is reported as two rows — one per currency.\n",
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by department name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Filter by country name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "format": "date",
            "required": false,
            "description": "Start of effective-date range (ISO-8601)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "format": "date",
            "required": false,
            "description": "End of effective-date range (ISO-8601)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "report data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReportRow"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/total-payroll-by-country": {
      "get": {
        "summary": "Total payroll by country",
        "tags": [
          "Reports"
        ],
        "operationId": "totalPayrollByCountry",
        "description": "Total compensation (base + bonus + allowance) per country (BR-3, FR-7.3).\nA country is paid in exactly one currency, so there is one row per country.\n",
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by department name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Filter by country name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "format": "date",
            "required": false,
            "description": "Start of effective-date range (ISO-8601)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "format": "date",
            "required": false,
            "description": "End of effective-date range (ISO-8601)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "report data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReportRow"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/employee-counts": {
      "get": {
        "summary": "Employee counts",
        "tags": [
          "Reports"
        ],
        "operationId": "employeeCounts",
        "description": "Head count grouped by department, country or job title (FR-7.5). No salary record is required for an employee to be counted.",
        "parameters": [
          {
            "name": "group_by",
            "in": "query",
            "required": true,
            "enum": [
              "department",
              "country",
              "job_title"
            ],
            "description": "Dimension to group by:\n * `department` \n * `country` \n * `job_title` \n ",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by department name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Filter by country name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_title",
            "in": "query",
            "required": false,
            "description": "Filter by job title",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "count data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EmployeeCountRow"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "unknown group_by value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/salary-distribution": {
      "get": {
        "summary": "Salary distribution",
        "tags": [
          "Reports"
        ],
        "operationId": "salaryDistribution",
        "description": "Number of salary records per band (FR-7.2).\nBands: 0-25k, 25k-50k, 50k-75k, 75k-100k, 100k+.\n",
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by department name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Filter by country name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "format": "date",
            "required": false,
            "description": "Start of effective-date range (ISO-8601)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "format": "date",
            "required": false,
            "description": "End of effective-date range (ISO-8601)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "distribution data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DistributionRow"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/salary-trends": {
      "get": {
        "summary": "Salary trends",
        "tags": [
          "Reports"
        ],
        "operationId": "salaryTrends",
        "description": "Average base salary per effective-date period, ordered ascending (FR-7.4).",
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by department name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Filter by country name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "format": "date",
            "required": false,
