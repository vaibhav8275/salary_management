    "/api/v1/salary-imports/{id}/errors": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "SalaryImport id",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "List the failed rows of a salary import",
        "tags": [
          "Salary Imports"
        ],
        "operationId": "listSalaryImportErrors",
        "description": "The rows behind `failed_records`: row_number, employee_id, error_message\nand the raw_data exactly as it arrived in the file. Paginated 50 rows to a\npage, because an import over the full employee set can reject most of its\nrows.\n\n`summary` is a roll-up of these same rows grouped by reason, returned\nalongside the page so the two cannot disagree for an import that is still\nrunning. A whole-file failure appears here as a single row with\nrow_number 0 and no employee_id.\n",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "default": 1,
            "description": "1-based page number. A missing or invalid value is treated as 1.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "page of failed rows, with counts by reason",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SalaryImportError"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer",
                          "example": 1
                        },
                        "per_page": {
                          "type": "integer",
                          "example": 50
                        },
                        "total_count": {
                          "type": "integer",
                          "example": 60
                        },
                        "total_pages": {
                          "type": "integer",
                          "example": 2
                        }
                      },
                      "required": [
                        "current_page",
                        "per_page",
                        "total_count",
                        "total_pages"
                      ]
                    },
                    "summary": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SalaryImportErrorSummaryRow"
                      }
                    }
                  },
                  "required": [
                    "data",
                    "meta",
                    "summary"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "import not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/salary-imports/{id}/csv": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "SalaryImport id",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Download the uploaded CSV",
        "tags": [
          "Salary Imports"
        ],
        "operationId": "downloadSalaryImportCsv",
        "description": "The file exactly as it was uploaded, sent back under the name it was\nuploaded with (LLD §9.3: the storage key is never exposed).\n\nDeliberately not a signed storage URL — that would put a token in a URL\nthe browser can read and send the user to a different origin. A blob can\nbe gone while its attachment record remains, so a missing file is a 404\nwith code `file_missing` rather than a 500.\n",
        "responses": {
          "200": {
            "description": "the uploaded file",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "import not found, or the file is gone",
            "content": {
              "text/csv": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
