    "/api/v1/employees/{id}/salary/audit": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Employee id",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Salary audit trail",
        "tags": [
          "Salary"
        ],
        "operationId": "getSalaryAudit",
        "description": "The change history of every salary record belonging to this employee,\ngrouped by the record the change belongs to (FR-2.5, LLD §7.1).\n\nOne entry per salary record, ordered by each record's most recent change\n(newest first), and each holding only that record's own versions (newest\nfirst). A record that was added but never updated reports just its\n`create` version.\n\nThe grouping is the point of this response: a flat list of versions\nanswers \"what changed?\" but not \"what happened to *this* record?\", which\nis the question a per-record change log has to answer.\n",
        "responses": {
          "200": {
            "description": "audit entries grouped by salary record",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "salary_record_id": {
                            "type": "integer",
                            "description": "The salary record these versions belong to"
                          },
                          "versions": {
                            "type": "array",
                            "description": "That record's changes, newest first",
                            "items": {
                              "$ref": "#/components/schemas/SalaryAudit"
                            }
                          }
                        },
                        "required": [
                          "salary_record_id",
                          "versions"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "employee not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
