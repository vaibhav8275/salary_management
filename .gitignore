# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

/config/credentials.yml.enc
/.kamal/secrets.*

# SimpleCov's HTML report and its raw resultset. Regenerated by any test run, so
# committing it would mean merging generated output on every suite change. The
# .resultset.json in particular is what the two suites merge into, and checking
# it in would let a stale local run inflate the reported number.
/coverage/

# Must stay last: this re-includes the committed template, so every pattern
# above that could match it has to come first.
!/.env.example
