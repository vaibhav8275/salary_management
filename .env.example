# Local development overrides. Gitignored; this is the committed template.
#
# The deploy path does NOT read this file under `-d production`. Kamal renders
# config/deploy.yml through ERB, and that ERB loads .kamal/secrets.production for
# EIP, AWS_ACCOUNT, FRONTEND_ORIGIN and REDIS_URL. .env is still loaded when no
# destination is given, purely so a bare `kamal deploy` can find them.
#
# So: production values live in .kamal/secrets.production (gitignored, per
# environment), and this file is for your machine.
#
# dotenv-rails loads it in every environment including production, which is why
# the app reads SALARY_MANAGEMENT_DATABASE_USERNAME and _PASSWORD from here in
# development. Blank values fall back to the stock local Postgres defaults in
# config/database.yml -- role "admin", database "salary_management_development" --
# so a fresh clone needs nothing filled in.

# --- Local database --------------------------------------------------------
SALARY_MANAGEMENT_DATABASE_USERNAME=
SALARY_MANAGEMENT_DATABASE_PASSWORD=
