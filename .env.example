# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Values here are placeholders only. Loaded by dotenv-rails in development and
# test; production reads the same variables from config/deploy.yml via Kamal.

# PostgreSQL role, password, and database name. config/database.yml reads these
# instead of hardcoding a value. Leave them blank to use the stock local Postgres
# defaults (role "admin", database "salary_management_development"), which is what
# a fresh clone gets. Fill them in to use a different role.
SALARY_MANAGEMENT_DATABASE_USERNAME=
SALARY_MANAGEMENT_DATABASE_PASSWORD=
SALARY_MANAGEMENT_DATABASE_NAME=

# Resolved by the AWS SDK default credential chain. The Active Storage :amazon
# service omits keys, so these are the only place the bucket credentials are
# read from.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Non-secret. Also defaulted in config/storage.yml, so these are only needed to
# override the defaults.
AWS_REGION=us-east-1
S3_BUCKET=salary-management-1

# Secret. Signs and verifies the JWT that authenticates API requests
# (LLD §9.4). Left empty, the app falls back to the Rails secret key base, which
# is fine for development; a deployment should set it explicitly so that rotating
# it does not require rotating the key base with it.
JWT_SECRET=
